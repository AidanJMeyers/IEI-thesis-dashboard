# ---------------------------------------------------------------------------
# Thesis Command Center - environment variables
#
# LEAVE THESE BLANK to run the dashboard in Local Mode: it seeds itself from
# context/*.json and persists your edits in the browser's localStorage.
# No account, no database, no setup required.
#
# FILL THESE IN to switch to Supabase Mode: shared database, file uploads,
# committee logins, and realtime updates. The UI is identical either way.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Required by scripts/seed.ts and scripts/setup-storage.ts.
# NEVER commit this value or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed when deploying to a GitHub Pages subpath.
# NEXT_PUBLIC_BASE_PATH=/IEI-thesis-dashboard
